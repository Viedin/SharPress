<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The sample host app, not part of the package. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- By default the sample builds against the library source. To try the library the way a consumer gets it,
       run ./pack-local.sh, which packs it into ./local-packages and runs the sample with UseLocalPackage=true. -->
  <ItemGroup Condition="'$(UseLocalPackage)' != 'true'">
    <ProjectReference Include="..\SharPress\SharPress.csproj" />
  </ItemGroup>

  <PropertyGroup Condition="'$(UseLocalPackage)' == 'true'">
    <RestoreAdditionalProjectSources>$(MSBuildThisFileDirectory)..\local-packages</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseLocalPackage)' == 'true'">
    <PackageReference Include="SharPress" Version="$(SharPressVersion)" />
  </ItemGroup>

</Project>
