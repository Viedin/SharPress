@using SharPress.Lib.Services
@* Rendered by the home endpoint in PageEndpoints. *@

<Shell>
    <HomeHero Home="Settings" />
    <MarkdownPageView Page="Page" ShowOutline="false" />
</Shell>

@code {
    /// <summary>The home page Markdown, or null if there is no home page file.</summary>
    [Parameter]
    public MarkdownPage? Page { get; set; }

    /// <summary>The hero and feature cards shown above the Markdown.</summary>
    [Parameter]
    public HomeSettings? Settings { get; set; }
}
