@using SharPress.Lib.Services
@* Rendered by the docs endpoint in PageEndpoints, which loads the page and navigation. *@

<Shell>
    <MarkdownPageView Page="Page" Navigation="Navigation" Previous="Previous" Next="Next" />
</Shell>

@code {
    /// <summary>The page to show, or null to show "Page not found".</summary>
    [Parameter]
    public MarkdownPage? Page { get; set; }

    [Parameter]
    public DocsNavigation? Navigation { get; set; }

    [Parameter]
    public NavItem? Previous { get; set; }

    [Parameter]
    public NavItem? Next { get; set; }
}
