<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Generates the minimal API endpoint code at compile time instead of building it with reflection at startup. -->
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
  </PropertyGroup>

  <!-- NuGet package -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>SharPress.Lib</PackageId>
    <!-- Set in Directory.Build.props; release builds pass the version from the git tag instead. -->
    <Version>$(SharPressVersion)</Version>
    <Title>SharPress</Title>
    <Authors>Filip Jinstrand</Authors>
    <Copyright>Copyright (c) 2026 Filip Jinstrand</Copyright>
    <Description>Turn a folder of Markdown files into a documentation site in an ASP.NET Core app. Navigation, an on-this-page outline, a home page, light and dark themes and custom styling, all from a small JSON file.</Description>
    <PackageTags>markdown;documentation;docs;docs-site;aspnetcore</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Viedin/SharPress</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Viedin/SharPress</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Ship symbols with the package so consumers can step into the library, and XML docs for IntelliSense. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Source Link: the symbols point at the exact commit on GitHub. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SharPress.Lib.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.4.0" />
  </ItemGroup>

  <!-- The starter files copied into a new site's SharpLib folder. Edit them in Templates/. -->
  <ItemGroup>
    <!-- .json files are content by default, which would copy the template into every consuming project. -->
    <Content Remove="Templates\**" />
    <None Remove="Templates\**" />
    <EmbeddedResource Include="Templates\**\*" LogicalName="Templates/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
