@using SharPress.Services
@using SharPress.Startup
@inject NavigationManager Navigation
@inject SiteFolders Folders

@if (Groups.Count > 0)
{
    <nav class="sp-nav" aria-label="Documentation">
        @* The site name links to the home page. A docs-only site has none, so the name is plain text there, and
           without a title or logo nothing is shown rather than a "Home" link that would lead back to the docs. *@
        @if (HasHomePage)
        {
            <a class="sp-nav-home" href="@Navigation.SiteUrl(Folders, "/")">
                @LogoImage
                @(string.IsNullOrWhiteSpace(SiteTitle) ? "Home" : SiteTitle)
            </a>
        }
        else if (!string.IsNullOrWhiteSpace(SiteTitle) || !string.IsNullOrWhiteSpace(SiteLogo))
        {
            <div class="sp-nav-home">
                @LogoImage
                @SiteTitle
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(Title))
        {
            <p class="sp-nav-title">@Title</p>
        }
        @foreach (var group in Groups)
        {
            <div class="sp-nav-group">
                @if (!string.IsNullOrWhiteSpace(group.Title))
                {
                    <p class="sp-nav-group-title">@group.Title</p>
                }
                <ul>
                    @foreach (var item in group.Items)
                    {
                        <li>
                            <NavLink href="@Navigation.SiteUrl(Folders, item.Href)"Match="NavLinkMatch.All">@item.Title</NavLink>
                        </li>
                    }
                </ul>
            </div>
        }
    </nav>
}

@code {
    [Parameter]
    public string? SiteTitle { get; set; }

    [Parameter]
    public string? SiteLogo { get; set; }

    [Parameter]
    public string? Title { get; set; }

    /// <summary>Whether the site has a home page for the site name to link to.</summary>
    [Parameter]
    public bool HasHomePage { get; set; }

    [Parameter]
    public IReadOnlyList<NavGroup> Groups { get; set; } = [];

    private RenderFragment LogoImage => @<text>
        @if (!string.IsNullOrWhiteSpace(SiteLogo))
        {
            <img class="sp-nav-logo" src="@Navigation.SiteUrl(Folders, SiteLogo)" alt="" />
        }
    </text>;
}
