@using SharPress.Services
@inject NavigationManager Navigation

@if (Groups.Count > 0)
{
    <nav class="sp-nav" aria-label="Documentation">
        <a class="sp-nav-home" href="@Navigation.SiteUrl("/")">
            @if (!string.IsNullOrWhiteSpace(SiteLogo))
            {
                <img class="sp-nav-logo" src="@Navigation.SiteUrl(SiteLogo)" alt="" />
            }
            @(string.IsNullOrWhiteSpace(SiteTitle) ? "Home" : SiteTitle)
        </a>
        @if (!string.IsNullOrWhiteSpace(Title))
        {
            <p class="sp-nav-title">@Title</p>
        }
        @foreach (var group in Groups)
        {
            <div class="sp-nav-group">
                @if (!string.IsNullOrWhiteSpace(group.Title))
                {
                    <p class="sp-nav-group-title">@group.Title</p>
                }
                <ul>
                    @foreach (var item in group.Items)
                    {
                        <li>
                            <NavLink href="@Navigation.SiteUrl(item.Href)"Match="NavLinkMatch.All">@item.Title</NavLink>
                        </li>
                    }
                </ul>
            </div>
        }
    </nav>
}

@code {
    [Parameter]
    public string? SiteTitle { get; set; }

    [Parameter]
    public string? SiteLogo { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public IReadOnlyList<NavGroup> Groups { get; set; } = [];
}
