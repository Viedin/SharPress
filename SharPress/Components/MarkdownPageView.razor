@using SharPress.Services

<PageTitle>@(Page?.Title ?? "SharPress")</PageTitle>

@if (Navigation is { Groups.Count: > 0 })
{
    @* Only shown on narrow screens, where the sidebar becomes a drawer opened from here (sharpress.js). *@
    <div class="sp-topbar">
        <button class="sp-menu-toggle" type="button" aria-controls="sp-sidebar" aria-expanded="false">
            <i class="bi bi-list"></i> Menu
        </button>
    </div>
    <div class="sp-backdrop"></div>
}

<div class="sp-layout">
    @if (Navigation is { Groups.Count: > 0 })
    {
        <aside class="sp-sidebar" id="sp-sidebar">
            <DocsNav SiteTitle="@Navigation.SiteTitle" SiteLogo="@Navigation.SiteLogo" Title="@Navigation.Title" HasHomePage="Navigation.HasHomePage" Groups="Navigation.Groups" />
        </aside>
    }

    <main class="sp-doc">
        @if (Page is null)
        {
            <p>Page not found.</p>
        }
        else
        {
            @((MarkupString)Page.Html)
            <PageNeighbours Previous="Previous" Next="Next" />
        }
    </main>

    @* Rendered even when there is no outline ("Page not found", pages without headings), so the page stays in
       the same place as on other docs pages instead of shifting right. *@
    @if (ShowOutline)
    {
        <aside class="sp-aside">
            <OnThisPage Headings="@(Page?.Headings ?? [])" />
        </aside>
    }
</div>

@code {
    [Parameter]
    public MarkdownPage? Page { get; set; }

    /// <summary>Whether to show the "On this page" outline to the right of the page.</summary>
    [Parameter]
    public bool ShowOutline { get; set; } = true;

    /// <summary>Optional navigation shown to the left of the page.</summary>
    [Parameter]
    public DocsNavigation? Navigation { get; set; }

    /// <summary>Optional links to the pages before and after this one, shown below the content.</summary>
    [Parameter]
    public NavItem? Previous { get; set; }

    [Parameter]
    public NavItem? Next { get; set; }
}
