@* Outside development, the exception handler set up in UseSharPress renders this for failed requests
   (PageEndpoints.RenderErrorAsync). It has no URL of its own. *@
@using SharPress.Services
@using SharPress.Startup
@inject NavigationManager Navigation
@inject SiteFolders Folders

<Shell>
    <PageTitle>Error</PageTitle>

    <div class="sp-layout">
        <main class="sp-doc">
            <h1>Something went wrong</h1>
            <p>An error occurred while processing your request.</p>
            @if (!string.IsNullOrEmpty(RequestId))
            {
                <p>Request ID: <code>@RequestId</code></p>
            }
            <p><a href="@Navigation.SiteUrl(Folders, "/")">Back to the home page</a></p>
        </main>
    </div>
</Shell>

@code {
    [Parameter]
    public string? RequestId { get; set; }
}
