@using SharPress.Services
@using SharPress.Startup
@inject NavigationManager Navigation
@inject SiteFolders Folders

@if (Home is not null)
{
    @if (Home.Hero is { } hero)
    {
        <section class="sp-hero">
            @if (!string.IsNullOrWhiteSpace(hero.Image))
            {
                <img class="sp-hero-image" src="@Navigation.SiteUrl(Folders, hero.Image)" alt="@hero.Name" />
            }
            @if (!string.IsNullOrWhiteSpace(hero.Name))
            {
                <h1 class="sp-hero-name">@hero.Name</h1>
            }
            @if (!string.IsNullOrWhiteSpace(hero.Text))
            {
                <p class="sp-hero-text">@hero.Text</p>
            }
            @if (!string.IsNullOrWhiteSpace(hero.Tagline))
            {
                <p class="sp-hero-tagline">@hero.Tagline</p>
            }
            @if (hero.Actions.Count > 0)
            {
                <div class="sp-hero-actions">
                    @foreach (var action in hero.Actions.Where(a => !string.IsNullOrWhiteSpace(a.Link)))
                    {
                        <a class="sp-button sp-button-@(action.Theme == "alt" ? "alt" : "brand")" href="@Navigation.SiteUrl(Folders, action.Link)">@action.Text</a>
                    }
                </div>
            }
        </section>
    }

    @if (Home.Features.Count > 0)
    {
        <section class="sp-features">
            @foreach (var feature in Home.Features)
            {
                @if (string.IsNullOrWhiteSpace(feature.Link))
                {
                    <div class="sp-feature">
                        <FeatureContent Feature="feature" />
                    </div>
                }
                else
                {
                    <a class="sp-feature sp-feature-link" href="@Navigation.SiteUrl(Folders, feature.Link)">
                        <FeatureContent Feature="feature" />
                    </a>
                }
            }
        </section>
    }
}

@code {
    [Parameter]
    public HomeSettings? Home { get; set; }
}
